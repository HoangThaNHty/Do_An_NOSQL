# ===== Copy file nay thanh .env roi chinh cho may cua ban =====
# KHONG duoc commit file .env len GitHub

# --- Flask ---
SECRET_KEY=doi-secret-key-cua-ban-o-day
FLASK_DEBUG=1
PORT=5000

# --- MongoDB (DB goc) ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=nosql_news

# --- Redis (Cache + Session) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- TTL (giay) ---
TTL_ARTICLE_CACHE=300
TTL_ARTICLE_CACHE_HOT=1800
TTL_ARTICLE_LIST=60
TTL_SESSION=1800
TTL_VIEWS=86400

# --- Mo phong do tre mang khi doc DB goc (chi dung khi demo) ---
# 0 = tat. Dat 200 de gia lap MongoDB nam o may khac (nhu kich ban demo
# "doc DB goc ~200ms, doc Redis <5ms"). NHO DAT LAI 0 khi do hieu nang that.
SIMULATED_DB_LATENCY_MS=0
